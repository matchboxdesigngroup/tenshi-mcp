# Template only: the server does NOT load .env files (no dotenv; npm start is plain node).
# Set these in the environment of the process that starts the server: the `env` block
# of the MCP client entry (see .mcp.json.example), a shell `export`, or your process manager.
# TENSHI_MCP_SERVERS_PATH defaults to ./servers.json if not set
TENSHI_MCP_SERVERS_PATH=./servers.json
# Deprecated old name, removed in M5. Read only when TENSHI_MCP_SERVERS_PATH is
# unset or empty, with a startup warning. Rename it to TENSHI_MCP_SERVERS_PATH.
# SSH_MCP_SERVERS_PATH=./servers.json

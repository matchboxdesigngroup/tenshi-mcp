{
  "servers": [
    {
      "id": "example-server",
      "label": "Example Server",
      "host": "192.0.2.10",
      "port": 22,
      "user": "deploy",
      "privateKeyPath": "/path/to/key",
      "hostKeys": [
        "SHA256:EXAMPLEonlyReplaceWithTheVerifiedHostKey000"
      ],
      "sites": {
        "example.com": {
          "wordpressRoot": "/var/www/example.com/public",
          "logDir": "/var/log/nginx"
        }
      }
    }
  ]
}
